# Database (Neon or Supabase)
DATABASE_URL="postgresql://user:password@host/InkTheory?sslmode=require"
DIRECT_URL="postgresql://user:password@host/InkTheory?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here-minimum-32-chars"
AUTH_SECRET="your-super-secret-key-here-minimum-32-chars"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# PayPal (use sandbox first, then switch PAYPAL_ENVIRONMENT to live)
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_CURRENCY="INR"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
NEXT_PUBLIC_PAYPAL_CURRENCY="INR"

# Printrove
PRINTROVE_API_URL="https://api.printrove.com"
PRINTROVE_EMAIL=""
PRINTROVE_PASSWORD=""
PRINTROVE_SYNC_SOURCE="product-library"
PRINTROVE_SYNC_CATEGORY_IDS=""
PRINTROVE_DEFAULT_FRONT_DESIGN_ID=""
PRINTROVE_DEFAULT_BACK_DESIGN_ID=""
PRINTROVE_DESIGN_WIDTH="3000"
PRINTROVE_DESIGN_HEIGHT="3000"
PRINTROVE_DESIGN_TOP="10"
PRINTROVE_DESIGN_LEFT="50"
PRINTROVE_DEFAULT_COURIER_ID=""
PRINTROVE_COD="false"
PRINTROVE_WEBHOOK_SECRET=""

# Email (Nodemailer)
RESEND_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@gmail.com"
SMTP_PASS="your_app_password"
EMAIL_FROM="InkTheory <noreply@inktheory.in>"
CONTACT_TO_EMAIL="support@inktheory.in"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="InkTheory"
